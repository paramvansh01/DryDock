# Copy this file to .env and fill in the blanks:   cp .env.example .env
# .env holds passwords, so it is never committed (it is in .gitignore).

# ---- Exasol connection -------------------------------------------------------
# Exasol Personal listens on port 8563 with a self-signed certificate.
# For a local install, keep EXA_TLS_NOCERTCHECK=1. For a remote server, put the
# certificate fingerprint in EXA_CERT_FINGERPRINT and set EXA_TLS_NOCERTCHECK=0.
EXA_DSN=127.0.0.1:8563
EXA_CERT_FINGERPRINT=
EXA_TLS_NOCERTCHECK=1

# ---- Database users ----------------------------------------------------------
# The admin account Exasol gave you. Used only to create the two users below and
# to load the demo data.
EXA_ADMIN_USER=sys
EXA_ADMIN_PASSWORD=

# The service user: the only writer. Pick any strong password;
# scripts/create_users.py creates the user with it.
DRYDOCK_SVC_USER=DRYDOCK_SVC
DRYDOCK_SVC_PASSWORD=

# The agent user: read-only. Pick a different strong password.
DRYDOCK_AGENT_USER=DRYDOCK_AGENT
DRYDOCK_AGENT_PASSWORD=

# ---- Google Gemini -------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
DRYDOCK_PLANNER_MODEL=gemini-3.5-flash
DRYDOCK_ADJ_MODEL=gemini-3.5-flash
# Thinking level: MINIMAL | LOW | MEDIUM | HIGH
DRYDOCK_PLANNER_THINKING=HIGH
DRYDOCK_ADJ_THINKING=MEDIUM

# ---- Optional: in-database adjudicator ------------------------------------------
# Leave as is unless you have deployed a model with scripts/ladder.py (step b6 prints the values).
DRYDOCK_ADJUDICATOR=gemini_fallback
DRYDOCK_AI_SCHEMA=
DRYDOCK_AI_BUCKETFS_CONN=
DRYDOCK_AI_SUBDIR=
DRYDOCK_AI_MODEL=

# Do NOT put DRYDOCK_VERIFY_KEY here. It is a secret you type in your terminal;
# Drydock refuses to run if it finds it in .env.
